# Jobby Local Environment Configuration

# OpenRouter API (Required for AI skill suggestions and inference)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Local Storage Paths
JOBBY_DATA_DIR=./data
JOBBY_DB_PATH=./data/profile/master-profile.db

# Local Agent Server Configuration
JOBBY_PORT=3141
JOBBY_HOST=127.0.0.1
